<!DOCTYPE html>
<html>
<head>
    <title>College Timetable</title>

    <style>
        body {
            font-family: "Times New Roman", serif;
        }

        h2 {
            text-align: center;
            margin-bottom: 10px;
        }

        table {
            width: 95%;
            margin: auto;
            border-collapse: collapse;
            text-align: center;
            font-size: 18px;
        }

        th, td {
            border: 2px solid black;
            padding: 12px;
        }

        th {
            font-weight: bold;
        }

        .lab-details {
            width: 100%;
            border-collapse: collapse;
        }

        .lab-details th,
        .lab-details td {
            border: 2px solid black;
            padding: 8px;
        }
    </style>
</head>

<body>

<h2>College Timetable - CSE Department</h2>

<table>

    <!-- Heading -->
    <tr>
        <th>Day / Time</th>
        <th>9:00 - 10:00</th>
        <th>10:00 - 11:00</th>
        <th>11:00 - 12:00</th>
        <th>12:00 - 1:00</th>
        <th>1:00 - 2:00</th>
        <th>2:00 - 3:00</th>
        <th>3:00 - 4:00</th>
    </tr>

    <!-- Monday -->
    <tr>
        <th>Monday</th>
        <td>Mathematics</td>
        <td>English</td>
        <td rowspan="3">Physics</td>
        <td>Break</td>
        <td colspan="2">Computer Lab</td>
        <td>Sports</td>
    </tr>

    <!-- Tuesday -->
    <tr>
        <th>Tuesday</th>
        <td>Mathematics</td>
        <td>C Programming</td>
        <td>Break</td>
        <td colspan="2">Electronics Lab</td>
        <td>Library</td>
    </tr>

    <!-- Wednesday -->
    <tr>
        <th>Wednesday</th>
        <td>Mathematics</td>
        <td>English</td>
        <td>Break</td>
        <td colspan="2">Computer Networks</td>

        <td>
            <table class="lab-details">
                <tr>
                    <th colspan="2">Lab Details</th>
                </tr>
                <tr>
                    <td>Batch A</td>
                    <td>DBMS Lab</td>
                </tr>
                <tr>
                    <td>Batch B</td>
                    <td>OS Lab</td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Thursday -->
    <tr>
        <th>Thursday</th>
        <td colspan="2">Workshop</td>
        <td>Physics</td>
        <td>Break</td>
        <td>Mathematics</td>
        <td>English</td>
        <td>Seminar</td>
    </tr>

    <!-- Friday -->
    <tr>
        <th>Friday</th>
        <td>Computer Networks</td>
        <td>English</td>
        <td>Physics</td>
        <td>Break</td>
        <td colspan="3">Project Work</td>
    </tr>

</table>

</body>
</html>